{
  "_INSTRUCTIONS": "REPLACE THIS FILE with your real google-services.json from Firebase Console",
  "_STEPS": [
    "1. Go to https://console.firebase.google.com",
    "2. Create a new project named 'Emobilis'",
    "3. Add an Android app with package name: com.emobilis.app",
    "4. Download google-services.json",
    "5. Replace this file with the downloaded one"
  ],
  "project_info": {
    "project_number": "YOUR_PROJECT_NUMBER",
    "project_id": "YOUR_PROJECT_ID",
    "storage_bucket": "YOUR_PROJECT_ID.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "1:YOUR_PROJECT_NUMBER:android:YOUR_APP_ID",
        "android_client_info": {
          "package_name": "com.emobilis.app"
        }
      },
      "api_key": [{ "current_key": "YOUR_API_KEY" }],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": []
        }
      }
    }
  ],
  "configuration_version": "1"
}
